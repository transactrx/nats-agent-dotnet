<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TransactRx.NatsAgent</RootNamespace>
    <AssemblyName>TransactRx.NatsAgent</AssemblyName>

    <!-- NuGet package. CI sets the real version (dotnet pack -p:Version=...). -->
    <PackageId>TransactRx.NatsAgent</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>RedSail Technologies</Authors>
    <Description>.NET implementation of the NATS Agent Protocol: AI agents and network agentic tools on NATS (agent runtime, clients, tool host, identity checks). Wire-compatible with the Go library github.com/transactrx/nats-agent.</Description>
    <PackageTags>nats;agent;ai;tools;protocol</PackageTags>
    <RepositoryUrl>https://github.com/transactrx/nats-agent-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member carries an XML comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Debug symbols travel inside the dll, so no separate symbol package is needed. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NATS.Client.Core" Version="3.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <!-- Not used directly: the NATS client depends on these and asks only for old minimum
       versions (Primitives 6.0.0, NKeys 1.0.1). Naming them here lifts the versions that
       this package and its consumers resolve to the current releases. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="11.0.0" />
    <PackageReference Include="NATS.NKeys" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="TransactRx.NatsAgent.Tests" />
  </ItemGroup>

</Project>
